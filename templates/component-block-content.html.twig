{#
/**
 * @file
 * Template for Component Block content rendering.
 *
 * Available variables:
 * - component_type: The first/primary component type (for backwards compatibility)
 * - component_name: Human-readable component name
 * - configuration: Component configuration array
 * - attributes: HTML attributes for the container
 * - block_content: The block content entity
 */
#}

<div{{ attributes.addClass([
  'component-block-wrapper',
  component_type ? 'component-block-' ~ component_type|clean_class : 'component-block-empty',
  block_content.field_component_config|length > 1 ? 'component-block-multiple' : 'component-block-single',
  block_content.field_component_config.isEmpty ? 'component-block-empty' : 'component-block-configured'
]) }}>

  {% if block_content and block_content.field_component_config and not block_content.field_component_config.isEmpty %}
    {# Render all components using the component field system #}
    <div class="component-block-components">
      {{ block_content.field_component_config }}
    </div>
  {% else %}
    {# Empty state #}
    <div class="component-block-empty">
      <div class="component-block-empty-icon">🎨</div>
      <p>{{ 'Component block not configured'|t }}</p>
    </div>
  {% endif %}

</div>